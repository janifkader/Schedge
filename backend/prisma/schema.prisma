generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- MODELS ---

model User {
  email          String   @id @unique
  name           String
  password       String
  phone          String?  // Made optional. Best practice so signup doesn't block if they skip it.
  refresh_token  String?  @unique // Optional, as it won't exist until they log in.

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- RELATIONS (Reverse lookups generated by Prisma) ---
  schedule       Schedule?
  teamSchedules  TeamSchedule[]
  requestsSent   Request[]      @relation("RequestsSent")
  requestsRecv   Request[]      @relation("RequestsReceived")
  teamsLed       Team[]         @relation("TeamLeader")
  participations Participates[]
  memberships    Membership[]
}

model Schedule {
  sched_id       String   @id @default(uuid())
  user_email     String   @unique

  // Maps the user_email string to the actual User model
  user           User     @relation(fields: [user_email], references: [email])
}

model TeamSchedule {
  sched_id       String   @id @default(uuid())
  owner_email    String   
  team_id        String   @unique

  owner          User     @relation(fields: [owner_email], references: [email])
  team           Team     @relation(fields: [team_id], references: [team_id])
}

model Request {
  request_id     String   @id @default(uuid())
  event_id       String
  sender_email   String
  receiver_email String
  status         String
  last_updated   DateTime

  // Disambiguates relations since two fields point to the User table
  event          Event    @relation(fields: [event_id], references: [event_id])
  sender         User     @relation("RequestsSent", fields: [sender_email], references: [email])
  receiver       User     @relation("RequestsReceived", fields: [receiver_email], references: [email])
}

model Team {
  team_id        String   @id @default(uuid())
  team_name      String
  leader_email   String

  leader         User     @relation("TeamLeader", fields: [leader_email], references: [email])
  teamSchedule   TeamSchedule?
  participations Participates[]
  members        Membership[]
}

model Event {
  event_id       String   @id @default(uuid())
  title          String
  date           DateTime
  weight         String
  cycle          String
  span           String
  
  schedule_id    String

  participants   Participates[]
  requests       Request[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Fixed the index reference
  @@index([date])
}

// --- JOIN TABLES ---

model Participates {
  participation_id String @id @default(uuid())
  user_email     String?
  team_id        String?
  event_id       String

  user           User?    @relation(fields: [user_email], references: [email])
  team           Team?    @relation(fields: [team_id], references: [team_id])
  event          Event    @relation(fields: [event_id], references: [event_id])

  @@unique([user_email, event_id])
  @@unique([team_id, event_id])
}

model Membership {
  user_email     String
  team_id        String

  user           User     @relation(fields: [user_email], references: [email])
  team           Team     @relation(fields: [team_id], references: [team_id])

  @@id([user_email, team_id])
}